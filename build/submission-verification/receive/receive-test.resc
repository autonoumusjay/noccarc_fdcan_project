mach create "receiver"
machine LoadPlatformDescription @/home/jt/Downloads/noccarc_fdcan_project.yzaoO4/renode/assignment.repl
sysbus LoadELF @/home/jt/Downloads/noccarc_fdcan_project.yzaoO4/build/node2/node2.elf
cpu PerformanceInMips 20
emulation RunFor "0.2"
python "from System import Array, Byte; from Antmicro.Renode.Core.CAN import CANMessageFrame; self.Machine['sysbus.fdcan1'].OnFrameReceived(CANMessageFrame(259, Array[Byte]([1, 3, 1, 0]), False, False, True, True))"
python "from System import Array, Byte; from Antmicro.Renode.Core.CAN import CANMessageFrame; self.Machine['sysbus.fdcan1'].OnFrameReceived(CANMessageFrame(275, Array[Byte]([1, 3, 7, 0, 11, 0, 0, 0, 12, 0, 0, 0, 13, 0, 0, 0, 14, 0, 0, 0, 15, 0, 0, 0]), False, False, True, True))"
emulation RunFor "0.02"
echo "GROUP before"
sysbus ReadBytes 0x2000005c 28
echo "INVALID before"
sysbus ReadDoubleWord 0x200000f0
python "from System import Array, Byte; from Antmicro.Renode.Core.CAN import CANMessageFrame; self.Machine['sysbus.fdcan1'].OnFrameReceived(CANMessageFrame(276, Array[Byte]([1, 3, 8, 0, 91, 0, 0, 0, 92, 0, 0, 0, 93, 0, 0, 0, 94, 0, 0, 0, 95, 0, 0, 0]), False, False, True, True))"
python "from System import Array, Byte; from Antmicro.Renode.Core.CAN import CANMessageFrame; self.Machine['sysbus.fdcan1'].OnFrameReceived(CANMessageFrame(275, Array[Byte]([1, 3, 8, 0, 91, 0, 0, 0, 92, 0, 0, 0, 93, 0, 0, 0]), False, False, True, True))"
python "from System import Array, Byte; from Antmicro.Renode.Core.CAN import CANMessageFrame; self.Machine['sysbus.fdcan1'].OnFrameReceived(CANMessageFrame(275, Array[Byte]([1, 3, 7, 0, 81, 0, 0, 0, 82, 0, 0, 0, 83, 0, 0, 0, 84, 0, 0, 0, 85, 0, 0, 0]), False, False, True, True))"
emulation RunFor "0.02"
echo "GROUP after"
sysbus ReadBytes 0x2000005c 28
echo "INVALID after"
sysbus ReadDoubleWord 0x200000f0
python "from System import Array, Byte; from Antmicro.Renode.Core.CAN import CANMessageFrame; self.Machine['sysbus.fdcan1'].OnFrameReceived(CANMessageFrame(275, Array[Byte]([1, 3, 8, 0, 91, 0, 0, 0, 92, 0, 0, 0, 93, 0, 0, 0, 94, 0, 0, 0, 95, 0, 0, 0]), False, False, True, True))"
emulation RunFor "0.02"
echo "GROUP next"
sysbus ReadBytes 0x2000005c 28
echo "INVALID next"
sysbus ReadDoubleWord 0x200000f0
quit
