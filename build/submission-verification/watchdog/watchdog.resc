mach create "watchdog-test"
machine LoadPlatformDescription @/home/jt/Downloads/noccarc_fdcan_project.yzaoO4/renode/assignment.repl
cpu PerformanceInMips 20
macro reset
"""
    cpu VectorTableOffset 0x08000000
    sysbus LoadELF @/home/jt/Downloads/noccarc_fdcan_project.yzaoO4/build/node2/node2.elf
"""
runMacro $reset
emulation RunFor "1.4"
echo "FEEDS BEFORE STALL"
sysbus ReadDoubleWord 0x200000ec
echo "STALL TIMER"
sysbus WriteDoubleWord 0x40000000 0
emulation RunFor "0.7"
echo "PRE-EXPIRY"
emulation RunFor "0.9"
echo "FEEDS AFTER REBOOT"
sysbus ReadDoubleWord 0x200000ec
quit
